---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { TEST } from "@consts";

const uid = 2186372;

const response = await fetch(`https://www.luogu.com.cn/user/${uid}`, {
  headers: {
    "x-lentille-request": "content-only",
  },
});

const json = await response.json();
const data = json.data;

const total = data.user.passedProblemCount;
const dailyCounts = data.dailyCounts;

function getChinaDate(offset: number = 0): string {
  const now = new Date(Date.now() + 8 * 3600 * 1000);

  return new Date(
    Date.UTC(
      now.getUTCFullYear(),
      now.getUTCMonth(),
      now.getUTCDate() - offset,
    ),
  )
    .toISOString()
    .slice(0, 10);
}

const recentDays = Array.from({ length: 10 }, (_, i) => {
  const date = getChinaDate(i + 1);

  return {
    date,
    label: date.slice(5),
    count: dailyCounts[date]?.[0] ?? 0,
  };
});

const maxCount = Math.max(...recentDays.map((item) => item.count), 1);
---

<PageLayout title={TEST.TITLE} description={TEST.DESCRIPTION}>
  <Container>
    <p class="animate">How are you today ?</p>

    <div class="stats">
      <div class="total animate">
        <span>Accepted Problems</span>
        <strong>{total}</strong>
      </div>

      <div class="section-title animate">Recent 3 Days</div>

      {recentDays.map((item) => (
        <div class="skill-bar animate">
          <span class="skill-label">{item.label}</span>

          <div class="track">
            <div
              class="fill"
              style={`width: ${(item.count / maxCount) * 100}%`}
            />
          </div>

          <span class="skill-percent">{item.count}</span>
        </div>
      ))}
    </div>
  </Container>
</PageLayout>

<style>
  .stats {
    max-width: 640px;
    margin-top: 2.5rem;
  }

  .total {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--theme-border);
  }

  .total span {
    font-size: 0.9rem;
    color: var(--theme-text-muted);
  }

  .total strong {
    font-size: 2rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .section-title {
    margin-bottom: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .skill-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .skill-label {
    min-width: 3.5rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .track {
    flex: 1;
    height: 0.5rem;
    overflow: hidden;
    background: var(--theme-border);
    border-radius: 9999px;
  }

.fill {
  height: 100%;
  background: #fff;
  border-radius: 9999px;
  transition: width 0.8s ease;
}

  .skill-percent {
    min-width: 2rem;
    color: var(--theme-text-muted);
    font-size: 0.8rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>